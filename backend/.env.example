# ─────────────────────────────────────────────────────────────
# ADHD Atlas – Backend optional configuration
#
# This app is BYOK (Bring Your Own Key): the Gemini API key is
# supplied by the user at runtime via the 🔑 button in the UI.
# No API key is stored server-side.
#
# Copy this file to .env only if you need to override the
# defaults below for your deployment environment.
# ─────────────────────────────────────────────────────────────

# Default Gemini model (used if the user does not specify one)
GEMINI_MODEL=gemini-2.0-flash

# Runtime environment (development | production)
ENVIRONMENT=development

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
